# Runtime
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Service-to-service security. Required when ENVIRONMENT=production.
AUTH_REQUIRED=false
MODEL_SERVER_API_KEY=dev-internal-model-key-replace-before-production
CORS_ORIGINS=http://localhost:8000

# Immutable model and data artifacts
MODELS_DIR=./models
MODEL_MANIFEST_FILE=./models/manifest.json
FEATURE_DATA_FILE=./data/processed/features_serving.parquet
SPATIAL_INDEX_FILE=./data/processed/spatial_index.parquet
VERIFY_MODEL_CHECKSUMS_ON_STARTUP=false
ALLOW_PROTOTYPE_MODELS=false
ALLOW_EXPERIMENTAL_RELEASE=false

# Runtime limits
MAX_LOADED_MODELS=2
MAX_RAM_MB=2048
MODEL_MEMORY_EXPANSION_FACTOR=2.25
MAX_CONCURRENT_REQUESTS=1
QUEUE_TIMEOUT_SECONDS=5
REQUEST_EXECUTION_TIMEOUT_SECONDS=30
MAX_EXPANDED_SYNC_TARGETS=40
MAX_NEAREST_DISTANCE_KM=8
MAX_TARGETS_PER_REQUEST=40
MAX_CACHE_ENTRIES=1000
CACHE_TTL_SECONDS=86400

# Optional Redis cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
